  "auto": {
    "intro": "{Titre} {victime} a été retrouvé{e} sans vie à la Forge du Dragon, encore tiède. {Nombre} artisans et clients s'y pressaient cette nuit-là. Un seul était avec {lui}.",
    "epilogues": {
      "dragonnet": "{coupable} avoue en soufflant une volute : {victime} avait éteint sa forge avec un seau d'eau « pour économiser le charbon ».",
