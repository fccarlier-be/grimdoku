      "chevalier": "{coupable} avoue en grinçant : {victime} lui avait forgé une armure encore plus petite que l'ancienne.",
      "gobelin": "{coupable} avoue : {victime} avait remarqué que les épées vendues étaient en fer-blanc peint.",
      "troll": "{coupable} avoue : {victime} se servait de sa tête comme enclume de secours.",
      "ogre": "{coupable} avoue, rouge de honte : {victime} lui avait forgé une fourchette géante. Il était végétarien depuis mardi.",
      "mage": "{coupable} avoue en éternuant : {victime} avait trempé une lame enchantée dans un tonneau de bière."
    }
