  "auto": {
    "intro": "{Titre} {victime} a été retrouvé{e} sans vie au Palais des Mille Vœux, sous un tapis volant qui ne volait plus. {Nombre} invités avaient fait un vœu ce soir-là. Un seul était avec {lui}.",
    "epilogues": {
      "djinn": "{coupable} avoue : {victime} réclamait un quatrième vœu. Il n'y a jamais de quatrième vœu.",
      "roi": "{coupable} avoue, la couronne de travers : {victime} avait souhaité devenir roi à sa place. Le vœu a été annulé.",
      "cartomancienne": "{coupable} l'avait lu dans les cartes : {victime} allait vider le trésor. Elle a préféré prendre les devants.",
      "bonimenteur": "{coupable} avoue d'une voix de stentor : {victime} vendait de fausses lampes magiques au bazar. C'était SON commerce.",
      "gobelin": "{coupable} avoue : {victime} avait compté les pièces du trésor. Il en manquait. Le gobelin savait où.",
      "vampire": "{coupable} avoue : {victime} avait souhaité « un grand soleil sur le palais ». Le vœu a été exaucé. Elle, beaucoup moins.",
      "archimage": "{coupable} avoue en lissant sa barbe : {victime} avait souhaité devenir un plus grand magicien que lui. Inacceptable."
    }
  }
